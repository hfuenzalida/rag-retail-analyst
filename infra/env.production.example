# Copy to infra/.env.production — NEVER commit this file.

APP_ENV=production
APP_LOG_LEVEL=info
APP_BASE_URL=https://pilot.example.com
APP_READ_ONLY=false
APP_ENABLE_INGEST=true

APP_DB_URL=postgresql://postgres:REPLACE_ME@postgres-db:5432/rag_analyst
APP_RUNTIME_CONTROLS_PATH=/config/runtime-controls.yaml
APP_TENANT_CONFIG_PATH=/config/tenant.yaml

# Single-tenant pilot binding
APP_PILOT_CLIENT_ID=demo-retail

# Local LLM (sovereign hardware via tunnel/VPN)
# APP_LOCAL_LLM_CHAT_URL=http://llm-inference:11434/v1
# APP_LOCAL_LLM_EMBEDDINGS_URL=http://llm-inference:11434/v1

# Cloud LLM — enable only with capped production keys
APP_ENABLE_OPENAI=false
APP_ENABLE_ANTHROPIC=false
APP_ENABLE_GEMINI=false
# APP_OPENAI_API_KEY=

# Auth — rotate before go-live; prefer OIDC in production
APP_AUTH_JWT_SECRET=production-secret-rotate-before-go-live
# APP_OIDC_ISSUER_URL=
# APP_OIDC_CLIENT_ID=
# APP_OIDC_CLIENT_SECRET=

# Observability
# APP_LOGFIRE_TOKEN=
# APP_LOGFIRE_ENVIRONMENT=production

NEXT_PUBLIC_API_URL=https://pilot.example.com/api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Copy to infra/.env.preview for preview deployments (never commit secrets)

APP_ENV=preview
APP_LOG_LEVEL=info
APP_BASE_URL=http://localhost:3001
APP_READ_ONLY=true
APP_ENABLE_INGEST=false

APP_DB_URL=postgresql://postgres:preview-postgres@postgres-db:5432/rag_analyst
APP_RUNTIME_CONTROLS_PATH=/config/runtime-controls.yaml

# Cloud LLM: allowed with capped test keys only
APP_ENABLE_OPENAI=false
APP_ENABLE_ANTHROPIC=false
APP_ENABLE_GEMINI=false
# APP_OPENAI_API_KEY=

APP_AUTH_JWT_SECRET=preview-secret-rotate-before-deploy

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
POSTGRES_PASSWORD=preview-postgres

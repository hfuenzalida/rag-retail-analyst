# Copy to infra/.env.local for local development (never commit secrets)

APP_ENV=local
APP_LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000

# PostgreSQL (matches docker-compose service name)
APP_DB_URL=postgresql://postgres:postgres@postgres-db:5432/rag_analyst

# Local LLM endpoints (optional in Phase 0; wire in Phase 3)
# APP_LOCAL_LLM_CHAT_URL=http://llm-chat:11434/v1
# APP_LOCAL_LLM_EMBEDDINGS_URL=http://llm-embed:11434/v1

# Cloud LLM (disabled by default)
APP_ENABLE_OPENAI=false
APP_ENABLE_ANTHROPIC=false
APP_ENABLE_GEMINI=false
# APP_OPENAI_API_KEY=
# APP_ANTHROPIC_API_KEY=
# APP_GEMINI_API_KEY=

# Auth (dev only — rotate for staging/production)
APP_AUTH_JWT_SECRET=dev-secret-change-in-production

# Environment controls
APP_READ_ONLY=false
APP_ENABLE_INGEST=true
# APP_RUNTIME_CONTROLS_PATH=../infra/flags/runtime-controls.yaml

# Observability (optional)
# APP_LOGFIRE_TOKEN=
# APP_LOGFIRE_ENVIRONMENT=local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Copy to infra/.env.staging for staging deployments (never commit secrets)

APP_ENV=staging
APP_LOG_LEVEL=info
APP_BASE_URL=http://localhost:3002
APP_READ_ONLY=false
APP_ENABLE_INGEST=true

APP_DB_URL=postgresql://postgres:staging-postgres@postgres-db:5432/rag_analyst
APP_RUNTIME_CONTROLS_PATH=/config/runtime-controls.yaml

# Cloud LLM: test keys with spend caps
APP_ENABLE_OPENAI=false
APP_ENABLE_ANTHROPIC=false
APP_ENABLE_GEMINI=false
# APP_OPENAI_API_KEY=

APP_AUTH_JWT_SECRET=staging-secret-rotate-before-deploy
# APP_LOGFIRE_TOKEN=
# APP_LOGFIRE_ENVIRONMENT=staging

NEXT_PUBLIC_API_URL=http://localhost:8002
POSTGRES_PASSWORD=staging-postgres
